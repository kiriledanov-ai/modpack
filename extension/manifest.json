{
  "manifest_version": 3,
  "name": "Lunacy — mope.io",
  "version": "1.0.0",
  "description": "Оптимизированный зум, расширенный рендер, визуалы и онлайн-роли Lunacy.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Настройки Lunacy",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://mope.io/*", "https://www.mope.io/*"],
      "js": ["settings-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mope.io/*", "https://www.mope.io/*"],
      "js": ["config.js", "patch-core.js", "patch.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
